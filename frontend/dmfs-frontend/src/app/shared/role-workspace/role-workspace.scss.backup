:host {
  display: block;
  min-height: 100vh;
  background: #f7f7f5;
  color: #111;
}

* {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

.dashboard {
  min-height: 100vh;
  display: flex;
  background: #f7f7f5;
  color: #111;
}

/* ==========================================================
   SIDEBAR
   ========================================================== */

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 1000;

  width: 240px;
  height: 100vh;

  display: flex;
  flex-direction: column;

  padding: 24px 16px 18px;

  background: #fff;
  border-right: 1px solid #e5e5e3;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 0 7px 25px;
}

.brand-mark {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 9px;

  background: #111;
  color: #fff;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: .3px;
}

.brand-text {
  min-width: 0;
}

.brand-text strong {
  display: block;

  font-size: 13px;
  line-height: 1.1;
  font-weight: 750;
  letter-spacing: -.2px;
}

.brand-text span {
  display: block;

  margin-top: 4px;

  color: #999;

  font-size: 7px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: .8px;
}

/* ==========================================================
   NAVIGATION
   ========================================================== */

.navigation {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.nav-item {
  position: relative;

  width: 100%;
  min-height: 37px;

  display: flex;
  align-items: center;

  padding: 0 10px 0 17px;

  border: 0;
  border-radius: 7px;

  background: transparent;
  color: #777;

  font-size: 10px;
  font-weight: 600;

  text-align: left;
  cursor: pointer;

  transition:
    background .15s ease,
    color .15s ease;
}

.nav-item:hover {
  background: #f3f3f1;
  color: #111;
}

.nav-item.active {
  background: #111;
  color: #fff;
}

.nav-indicator {
  position: absolute;
  left: 7px;

  width: 3px;
  height: 3px;

  border-radius: 50%;
  background: currentColor;
  opacity: .8;
}

/* ==========================================================
   SIDEBAR ACCOUNT
   ========================================================== */

.sidebar-bottom {
  margin-top: auto;
}

.account {
  width: 100%;

  display: flex;
  align-items: center;
  gap: 9px;

  padding: 9px 7px;

  border: 0;
  border-top: 1px solid #eeeeec;

  background: transparent;
  color: #111;

  text-align: left;
  cursor: default;
}

.account-avatar {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #eeeeec;
  color: #111;

  font-size: 10px;
  font-weight: 700;
}

.account-details {
  min-width: 0;
}

.account-details strong {
  display: block;

  overflow: hidden;

  font-size: 10px;
  line-height: 1.3;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-details span {
  display: block;

  margin-top: 3px;

  color: #999;

  font-size: 8px;
}

.logout {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  margin-top: 12px;
  padding: 8px;

  border: 0;
  border-radius: 7px;

  background: transparent;
  color: #555;

  cursor: pointer;
}

.logout:hover {
  background: #f1f1ef;
  color: #111;
}

.logout-circle {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #d5d5d3;
  border-radius: 50%;

  background: #fff;
  color: #111;

  font-size: 13px;
}

.logout-text {
  font-size: 10px;
  font-weight: 600;
}

/* ==========================================================
   MAIN
   ========================================================== */

.main-content {
  width: calc(100% - 240px);
  min-height: 100vh;

  margin-left: 240px;

  display: flex;
  flex-direction: column;
}

.dashboard:not(.sidebar-open) .sidebar {
  display: none;
}

.dashboard:not(.sidebar-open) .main-content {
  width: 100%;
  margin-left: 0;
}

/* ==========================================================
   TOPBAR
   ========================================================== */

.topbar {
  width: 100%;
  min-height: 68px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 28px;

  background: #fff;
  border-bottom: 1px solid #e5e5e3;

  flex-shrink: 0;
}

.topbar-left {
  display: flex;
  align-items: center;
}

.open-menu-button {
  width: 36px;
  height: 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #d9d9d7;
  border-radius: 8px;

  background: #fff;
  color: #111;

  cursor: pointer;
  font-size: 16px;
}

.open-menu-button:hover {
  background: #f1f1ef;
}

.topbar-right {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.top-user {
  display: flex;
  align-items: center;
  gap: 9px;

  padding-left: 15px;

  border-left: 1px solid #e4e4e2;
}

.top-avatar {
  width: 36px;
  height: 36px;
  flex: 0 0 36px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #111;
  color: #fff;

  font-size: 10px;
  font-weight: 700;
}

.top-user-details strong {
  display: block;

  font-size: 10px;
  line-height: 1.3;
}

.top-user-details span {
  display: block;

  margin-top: 2px;

  color: #999;

  font-size: 8px;
}

/* ==========================================================
   PAGE
   ========================================================== */

.page {
  width: 100%;
  max-width: 1600px;

  margin: 0 auto;

  padding: 28px 32px 40px;
}

.page > * {
  min-width: 0;
}

/* ==========================================================
   PAGE HEADER
   ========================================================== */

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;

  margin-bottom: 24px;
}

.title-area {
  min-width: 0;
}

.eyebrow {
  margin: 0 0 6px;

  color: #888;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: 1px;
}

.page-header h2 {
  margin: 0;

  font-size: clamp(25px, 2.2vw, 32px);
  line-height: 1.1;

  font-weight: 700;
  letter-spacing: -1px;
}

.description {
  max-width: 700px;

  margin: 7px 0 0;

  color: #8d8d8d;

  font-size: 11px;
  line-height: 1.5;
}

/* ==========================================================
   KPI STATS
   ========================================================== */

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 12px;

  margin-bottom: 30px;
}

.stat-card {
  min-width: 0;
  min-height: 128px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 17px;

  background: #fff;
  border: 1px solid #e5e5e3;
  border-radius: 10px;
}

.stat-label {
  color: #777;

  font-size: 9px;
  font-weight: 650;

  text-transform: uppercase;
  letter-spacing: .2px;
}

.stat-number {
  font-size: clamp(27px, 2.5vw, 35px);
  line-height: 1;

  font-weight: 700;
}

.stat-description {
  color: #999;

  font-size: 9px;
  line-height: 1.35;
}

/* ==========================================================
   SECTION
   ========================================================== */

.section {
  margin-bottom: 30px;
}

.section-heading {
  margin-bottom: 11px;
}

.section-heading h3,
.card-header h3 {
  margin: 0;

  font-size: 15px;
  line-height: 1.25;

  font-weight: 650;
}

/* ==========================================================
   QUICK ACCESS
   ========================================================== */

.quick-access-grid {
  display: grid;

  grid-template-columns: repeat(
    3,
    minmax(0, 1fr)
  );

  gap: 12px;
}

.action-card {
  min-width: 0;
  min-height: 118px;

  display: grid;

  grid-template-columns: 38px minmax(0, 1fr) auto;

  align-items: center;
  gap: 12px;

  padding: 17px;

  background: #fff;

  border: 1px solid #e5e5e3;
  border-radius: 10px;

  color: #111;

  text-align: left;
  cursor: pointer;

  transition:
    border-color .15s ease,
    background .15s ease;
}

.action-card:hover {
  border-color: #cfcfcd;
  background: #fcfcfb;
}

.action-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #eeeeec;
  color: #111;

  font-size: 11px;
  font-weight: 700;
}

.action-content {
  min-width: 0;
}

.action-content strong {
  display: block;

  overflow: hidden;

  font-size: 11px;
  line-height: 1.3;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-content p {
  margin: 5px 0 0;

  color: #999;

  font-size: 9px;
  line-height: 1.4;
}

.arrow {
  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 1px solid #e0e0de;
  border-radius: 50%;

  color: #555;

  font-size: 12px;
}

/* ==========================================================
   LOWER OVERVIEW
   ========================================================== */

.lower-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(280px, .8fr);

  gap: 12px;
}

.overview-card {
  min-width: 0;
  min-height: 260px;

  padding: 19px;

  background: #fff;

  border: 1px solid #e5e5e3;
  border-radius: 10px;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;

  padding-bottom: 15px;

  border-bottom: 1px solid #eeeeec;
}

.card-header > div {
  min-width: 0;
}

.card-header p:last-child {
  margin: 4px 0 0;

  color: #999;

  font-size: 9px;
  line-height: 1.45;
}

/* ==========================================================
   WORK OVERVIEW
   ========================================================== */

.overview-list {
  padding-top: 7px;
}

.overview-row {
  min-height: 46px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  border-bottom: 1px solid #eeeeec;
}

.overview-row:last-child {
  border-bottom: 0;
}

.overview-row span {
  color: #666;

  font-size: 10px;
}

.overview-row strong {
  flex-shrink: 0;

  font-size: 17px;
}

/* ==========================================================
   ACTIVITY
   ========================================================== */

.activity-overview {
  min-height: 185px;

  display: flex;
  align-items: center;
  justify-content: center;
}

.activity-empty {
  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;
}

.activity-circle {
  width: 58px;
  height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 11px;

  border: 1px solid #dcdcd9;
  border-radius: 50%;

  background: #f7f7f5;
  color: #888;

  font-size: 17px;
}

.activity-empty strong {
  font-size: 11px;
  line-height: 1.3;
}

.activity-empty span {
  margin-top: 5px;

  color: #999;

  font-size: 9px;
  line-height: 1.4;
}

/* ==========================================================
   RESPONSIVE
   ========================================================== */

@media (max-width: 1200px) {

  .sidebar {
    width: 220px;
  }

  .main-content {
    width: calc(100% - 220px);
    margin-left: 220px;
  }

  .page {
    padding-left: 25px;
    padding-right: 25px;
  }

  .stats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .quick-access-grid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .lower-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {

  .sidebar {
    width: 235px;

    box-shadow:
      8px 0 25px rgba(0, 0, 0, .06);
  }

  .main-content,
  .dashboard:not(.sidebar-open) .main-content {
    width: 100%;
    margin-left: 0;
  }

  .topbar {
    min-height: 64px;
    padding: 11px 20px;
  }

  .page {
    padding: 23px 20px 34px;
  }

  .page-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .quick-access-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {

  .sidebar {
    width: min(235px, 82vw);
  }

  .topbar {
    padding: 10px 14px;
  }

  .page {
    padding: 19px 14px 30px;
  }

  .page-header h2 {
    font-size: 25px;
  }

  .stats {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .stat-card {
    min-height: 115px;
    padding: 14px;
  }

  .stat-number {
    font-size: 27px;
  }

  .top-user-details {
    display: none;
  }

  .action-card {
    min-height: 110px;
  }
}

@media (max-width: 390px) {

  .stats {
    grid-template-columns: 1fr;
  }

  .page {
    padding-left: 11px;
    padding-right: 11px;
  }

  .topbar {
    padding-left: 11px;
    padding-right: 11px;
  }
}
